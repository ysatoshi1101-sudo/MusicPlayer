<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_m"
    android:paddingEnd="@dimen/space_m"
    android:paddingTop="@dimen/space_s"
    android:paddingBottom="@dimen/space_s"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/song_thumbnail_size"
        android:layout_height="@dimen/song_thumbnail_size"
        app:cardCornerRadius="@dimen/radius_medium"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/color_mini_player_background">

        <ImageView
            android:id="@+id/imageViewAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="アルバムアート" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_m"
        android:orientation="vertical">

        <!-- このカードは常に不透明(color_surface)なため、背景機能の白文字テーマの対象外として
             文字色・影を明示的に固定する -->
        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.SDMusicPlayer.Body"
            android:textColor="@color/color_text_primary"
            android:shadowColor="@android:color/transparent"
            android:text="曲名" />

        <TextView
            android:id="@+id/textViewArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.SDMusicPlayer.BodySmall"
            android:textColor="@color/color_text_secondary"
            android:shadowColor="@android:color/transparent"
            android:text="アーティスト名" />

    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@android:drawable/btn_star_big_on"
        android:contentDescription="@null"
        app:tint="@color/color_favorite" />

</LinearLayout>