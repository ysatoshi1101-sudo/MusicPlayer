<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_m"
    android:layout_marginEnd="@dimen/space_m"
    android:layout_marginTop="@dimen/space_s"
    app:cardCornerRadius="?attr/skinCardCornerRadius"
    app:cardElevation="?attr/skinCardElevation"
    app:strokeWidth="?attr/skinCardStrokeWidth"
    app:strokeColor="?attr/colorPrimary"
    app:cardBackgroundColor="@color/color_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_s"
        android:paddingEnd="@dimen/space_s"
        android:paddingTop="@dimen/space_card"
        android:paddingBottom="@dimen/space_card">

        <!-- 並び替え用のドラッグハンドル。小さく薄くしたが、押しやすいようpaddingで当たり判定は確保する -->
        <TextView
            android:id="@+id/textViewDragHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_s"
            android:text="≡"
            android:textSize="20sp"
            android:textColor="@color/color_icon_secondary"
            android:alpha="0.6" />

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/playlist_row_cover_size"
            android:layout_height="@dimen/playlist_row_cover_size"
            android:layout_marginStart="@dimen/space_xs"
            app:cardCornerRadius="@dimen/radius_medium"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/color_mini_player_background">

            <ImageView
                android:id="@+id/imageViewPlaylistCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="プレイリストカバー" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_m"
            android:orientation="vertical">

            <!-- このカードは常に不透明(color_surface)なため、背景機能の白文字テーマの対象外として
                 文字色・影を明示的に固定する -->
            <TextView
                android:id="@+id/textViewPlaylistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.SDMusicPlayer.CardTitle"
                android:textColor="@color/color_text_primary"
                android:shadowColor="@android:color/transparent"
                android:text="プレイリスト名" />

            <TextView
                android:id="@+id/textViewPlaylistSongCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.SDMusicPlayer.BodySmall"
                android:textColor="@color/color_text_secondary"
                android:shadowColor="@android:color/transparent"
                android:text="0曲" />

        </LinearLayout>

        <!-- 名前の変更・削除をまとめたメニューボタン(曲一覧の「⋮」と同じ作り) -->
        <TextView
            android:id="@+id/buttonMorePlaylist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_s"
            android:text="⋮"
            android:textSize="22sp"
            android:textColor="@color/color_icon_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="メニュー" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
