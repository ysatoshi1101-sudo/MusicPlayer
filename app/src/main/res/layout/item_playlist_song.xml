<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/space_m"
    android:gravity="center_vertical">

    <CheckBox
        android:id="@+id/checkboxSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_s"
        android:visibility="gone" />

    <!-- PlaylistSongAdapter.kt が imageViewAlbumArt を参照するため、
         曲一覧(item_song.xml)と同じサムネイル表示を追加(以前は欠落していた) -->
    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/song_thumbnail_size"
        android:layout_height="@dimen/song_thumbnail_size"
        app:cardCornerRadius="@dimen/radius_medium"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/color_mini_player_background">

        <ImageView
            android:id="@+id/imageViewAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="アルバムアート" />

        <!-- 再生中アニメーション機能で追加。再生中の曲の行でだけ表示される(普段はgone) -->
        <com.example.musicplayer.NowPlayingIndicatorView
            android:id="@+id/nowPlayingIndicator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:visibility="gone" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_m"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.SDMusicPlayer.Body"
            android:text="曲名" />

        <TextView
            android:id="@+id/textViewArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.SDMusicPlayer.BodySmall"
            android:text="アーティスト名" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/buttonRemove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_s"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="プレイリストから削除"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="?attr/bgTextColorSecondary" />

</LinearLayout>