<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/textViewScreenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_screen_horizontal"
        android:paddingEnd="@dimen/space_screen_horizontal"
        android:paddingTop="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.SDMusicPlayer.Title"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 検索バー: 角丸のカード風コンテナに統一 -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_screen_horizontal"
        android:layout_marginEnd="@dimen/space_screen_horizontal"
        android:layout_marginTop="@dimen/space_s"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_field"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_s"
        app:layout_constraintTop_toBottomOf="@id/textViewScreenTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="@null"
            app:tint="@color/color_icon_secondary" />

        <!-- 検索バーは常に不透明(bg_search_field)なため、背景機能の白文字テーマの対象外として
             入力文字色を明示的に固定する(ヒント文字は元々static色のため変更不要) -->
        <EditText
            android:id="@+id/editTextSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_s"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_m"
            android:hint="曲名・アーティストで検索"
            android:textAppearance="@style/TextAppearance.SDMusicPlayer.Body"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_secondary"
            android:inputType="text"
            android:background="@null"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/buttonSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_s"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="設定"
            android:src="@drawable/ic_settings_gear"
            app:tint="@color/color_icon_secondary" />

    </LinearLayout>

    <!-- 操作バー: シャッフル再生(主要導線)+ 曲数 + 一括操作 -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_screen_horizontal"
        android:paddingEnd="@dimen/space_s"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPlayShuffled"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s"
            android:text="シャッフル再生"
            android:textAppearance="@style/TextAppearance.SDMusicPlayer.Button"
            android:textColor="?attr/colorOnPrimary"
            app:icon="@drawable/ic_shuffle"
            app:iconTint="?attr/colorOnPrimary"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_xs"
            app:cornerRadius="@dimen/radius_button"
            app:backgroundTint="?attr/colorPrimary"
            android:contentDescription="シャッフル再生" />

        <TextView
            android:id="@+id/textViewSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:text="全選択"
            android:textAppearance="@style/TextAppearance.SDMusicPlayer.Button"
            android:textColor="?attr/colorPrimary"
            android:padding="@dimen/space_s"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textViewSongCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_m"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.SDMusicPlayer.BodySmall"
            android:text="0曲" />

        <ImageButton
            android:id="@+id/buttonAddAllFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:padding="@dimen/space_s"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="お気に入りに追加"
            android:src="@android:drawable/btn_star_big_off"
            app:tint="?attr/bgTextColorSecondary" />

        <ImageButton
            android:id="@+id/buttonAddAllPlaylist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:padding="@dimen/space_s"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="プレイリストに追加"
            android:src="@android:drawable/ic_menu_add"
            app:tint="?attr/bgTextColorSecondary" />

        <ImageButton
            android:id="@+id/buttonDeleteSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:padding="@dimen/space_s"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="削除"
            android:src="@android:drawable/ic_menu_delete"
            android:visibility="gone"
            app:tint="@color/color_error" />

        <ImageButton
            android:id="@+id/buttonMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:padding="@dimen/space_s"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="メニュー"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="?attr/bgTextColorSecondary" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSongs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_s"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_m"
        app:layout_constraintTop_toBottomOf="@id/controlBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 右端の可変ドラッグ式スクロールバー。recyclerViewSongsと同じ範囲に重ねて表示する -->
    <com.example.musicplayer.FastScrollerView
        android:id="@+id/fastScroller"
        android:layout_width="24dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/recyclerViewSongs"
        app:layout_constraintBottom_toBottomOf="@id/recyclerViewSongs"
        app:layout_constraintEnd_toEndOf="@id/recyclerViewSongs" />

</androidx.constraintlayout.widget.ConstraintLayout>